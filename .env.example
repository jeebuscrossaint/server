# The ending for all your app names. With "lab": http://pdf.lab, http://home.lab, ...
# The dns stack answers these, see README.
LAB_DOMAIN=lab

# The ThinkPad's Tailscale IP. Get it with: tailscale ip -4
TAILSCALE_IP=100.81.88.57

# Where this repo lives. install.fish fills it in.
HOMELAB_DIR=/opt/homelab

# Who the web terminal logs in as. install.sh fills it in.
SERVER_USER=amarnath

# Overleaf needs a fixed random secret. install.sh fills in every "change-me" with a random value.
OVERLEAF_INVITE_TOKEN_SECRET=change-me

# Overleaf's one user (you never type it, latex.lab signs you in automatically)
OVERLEAF_PASSWORD=change-me

# Dockge's and Transmute's one user (you never type these, the pages sign you in)
DOCKGE_PASSWORD=change-me
TRANSMUTE_PASSWORD=change-me
TRANSMUTE_SECRET=change-me

# Beszel's built-in user (you never type it, it logs you in automatically)
BESZEL_PASSWORD=change-me

# Readeck's one user (you never type it, keep.lab signs you in automatically)
READECK_PASSWORD=change-me

# ntfy's one user: your phone's ntfy app signs in with it (install.sh also makes
# NTFY_TOKEN, which ntfy.lab uses so the browser never asks)
NTFY_PASSWORD=change-me

# The public address for share.lab's links and your phone's ntfy (this machine's Tailscale Funnel address).
# install.sh fills it in from Tailscale.
PUBLIC_DOMAIN=server.example.ts.net
