# One block per app: <name>.{$LAB_DOMAIN} -> <container name>:<port inside container>
# After editing, restart the caddy stack in Dockge.
#
# HTTPS uses Caddy's own certificate authority. Each device trusts it once:
# download http://ca.lab and install it (see README).
{
	local_certs
	skip_install_trust
}

# The one page that stays plain http, so a new device can download the certificate.
# Only ever hands out root.crt, never anything else in that folder.
http://ca.{$LAB_DOMAIN} {
	root * /data/caddy/pki/authorities/local
	rewrite * /root.crt
	header Content-Disposition "attachment; filename=homelab-ca.crt"
	file_server
}

{$LAB_DOMAIN}, home.{$LAB_DOMAIN} {
	reverse_proxy glance:8080
}

dockge.{$LAB_DOMAIN} {
	reverse_proxy dockge:5001
}

pdf.{$LAB_DOMAIN} {
	reverse_proxy bentopdf:8080
}

convert.{$LAB_DOMAIN} {
	# no login screen: signs you in until the transmute_auto cookie says you are,
	# and again whenever you land on its login page (pages/convert-login.html)
	@login expression `header({'Sec-Fetch-Dest': 'document'}) && (!header_regexp('Cookie', 'transmute_auto=1') || path('/auth', '/auth/*'))`
	handle @login {
		root * /srv/pages
		rewrite * /convert-login.html
		header Cache-Control no-store
		templates
		file_server
	}
	reverse_proxy transmute:3313
}

changes.{$LAB_DOMAIN} {
	reverse_proxy changedetection:5000
}

term.{$LAB_DOMAIN} {
	reverse_proxy terminal:7681
}

draw.{$LAB_DOMAIN} {
	reverse_proxy excalidash:8080
}

latex.{$LAB_DOMAIN} {
	# no login screen: this page signs you in as the one user (see pages/latex-login.html)
	@login {
		method GET
		path /login
		not header X-Real-Login 1
	}
	handle @login {
		root * /srv/pages
		rewrite * /latex-login.html
		header Cache-Control no-store
		templates
		file_server
	}
	reverse_proxy overleaf:80
}

stats.{$LAB_DOMAIN} {
	reverse_proxy beszel:8090
}

keep.{$LAB_DOMAIN} {
	# no login screen: this page signs you in as the one user (see pages/keep-login.html)
	@login {
		method GET
		path /login
	}
	handle @login {
		root * /srv/pages
		rewrite * /keep-login.html
		header Cache-Control no-store
		templates
		file_server
	}
	reverse_proxy readeck:8000
}

tools.{$LAB_DOMAIN} {
	reverse_proxy omni-tools:80
}

logs.{$LAB_DOMAIN} {
	reverse_proxy dozzle:8080
}

share.{$LAB_DOMAIN} {
	# no login screen: Gokapi signs in whoever this header names (stacks/gokapi/setup.sh)
	reverse_proxy gokapi:53842 {
		header_up Remote-User lab
	}
}

# Gokapi's public links: Tailscale Funnel sends https://<PUBLIC_DOMAIN>:8443 here (see
# stacks/gokapi/compose.yaml). Never signed in, and the admin pages aren't reachable.
http://:3001 {
	@admin path /admin /apiKeys /auth/* /changePassword /downloadPresigned /e2eSetup /filerequests /forgotpw /index /login /logout /logs /uploadChunk /uploadStatus /users
	respond @admin 404
	reverse_proxy gokapi:53842 {
		header_up -Remote-User
	}
}
